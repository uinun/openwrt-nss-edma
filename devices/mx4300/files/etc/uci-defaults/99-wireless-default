#!/bin/sh

# 1. 确保系统自带的 wifi 探测生成基础配置
[ -f /etc/config/wireless ] || wifi config

# 2. 修改 radio 基础参数（信道、国家码、频宽、启用）
uci -q batch <<EOF
set wireless.radio0.channel='40'
set wireless.radio0.country='CN'
set wireless.radio0.htmode='HE80'
set wireless.radio0.disabled='0'

set wireless.radio1.channel='6'
set wireless.radio1.country='CN'
set wireless.radio1.htmode='HE20'
set wireless.radio1.disabled='0'

set wireless.radio2.channel='161'
set wireless.radio2.country='CN'
set wireless.radio2.htmode='HE80'
set wireless.radio2.disabled='0'
EOF

# 3. 引入 functions.sh 并定义遍历处理逻辑
. /lib/functions.sh

set_ssid_by_device() {
    local section="$1"
    local target_dev="$2"
    local new_ssid="$3"
    local dev

    config_get dev "$section" device
    if [ "$dev" = "$target_dev" ]; then
        uci -q set wireless."${section}".ssid="$new_ssid"
    fi
}

configure_iface() {
    local target_dev="$1"
    local new_ssid="$2"

    config_load wireless
    config_foreach set_ssid_by_device wifi-iface "$target_dev" "$new_ssid"
}

# 更新各个频段的 SSID
configure_iface "radio0" "Openwrt5.2G"
configure_iface "radio1" "Openwrt2.4G"
configure_iface "radio2" "Openwrt5.8G"

# 4. 提交保存
uci commit wireless

exit 0