# ==============================================================================
# 1. 目标平台与硬件架构 (Target System & Hardware)
# ==============================================================================
# 目标平台：Airoha (达发/联发科系芯片)

# 子架构：AN7581 SoC

# 目标设备：诺基亚 Nokia XG-040G-MD (UBI镜像固件)


# ==============================================================================
# 2. 编译选项与工具链 (Build System & Toolchain)
# ==============================================================================
# 开启开发与底层调试菜单
CONFIG_DEVEL=y
# 禁用：从源码编译 BPF 专用的 LLVM 工具链
# CONFIG_BPF_TOOLCHAIN_BUILD_LLVM is not set
# 启用：使用宿主机的 BPF 工具链
CONFIG_BPF_TOOLCHAIN_HOST=y
# 宿主机 BPF 工具链路径 (空则使用系统 PATH)
CONFIG_BPF_TOOLCHAIN_HOST_PATH=""
# 使用宿主机 LLVM 工具链加速编译
CONFIG_USE_LLVM_HOST=y

# ==============================================================================
# 3. 内核特性与基础配置 (Kernel Features & BusyBox)
# ==============================================================================
# 内核开启 /dev/mem 物理内存直接访问驱动
CONFIG_KERNEL_DEVMEM=y
# 内核开启网络 Page Pool (提升高速网卡吞吐)
CONFIG_KERNEL_PAGE_POOL=y
# 内核开启 relayfs 支持 (用于高速数据追踪/抓取)
CONFIG_KERNEL_RELAY=y
# 自定义 Busybox 功能组件
CONFIG_BUSYBOX_CUSTOM=y
# 启用 BusyBox 内置的 devmem 命令 (寄存器/内存读写)
CONFIG_BUSYBOX_CONFIG_DEVMEM=y

# ==============================================================================
# 4. 光猫/PON与特定芯片驱动 (PON & Proprietary Drivers)
# ==============================================================================
# Airoha EN8811H 2.5G PHY 芯片固件
CONFIG_PACKAGE_airoha-en8811h-firmware=y
# Airoha PON 底层调试分析工具
CONFIG_PACKAGE_airoha-pon-debug=y
# Airoha EN7572 芯片内核支持模块
CONFIG_PACKAGE_kmod-airoha-en7572=y
# BOSA 光收发模块分页驱动支持
CONFIG_PACKAGE_kmod-airoha-paged-bosa=y
# Airoha EN8811H 以太网 PHY 内核驱动
CONFIG_PACKAGE_kmod-phy-airoha-en8811h=y
# 禁用：MaxLinear PHY 驱动
# CONFIG_PACKAGE_kmod-phy-maxlinear is not set
# 禁用：Realtek 瑞昱 PHY 驱动
# CONFIG_PACKAGE_kmod-phy-realtek is not set
# 禁用：RTL826x PHY 固件
# CONFIG_PACKAGE_rtl826x-firmware is not set

# ==============================================================================
# 5. 无线 Wi-Fi 组件裁剪 (Wireless Feature Disabling - 纯有线/光猫模式)
# ==============================================================================
# 禁用 802.11ac 驱动支持
# CONFIG_DRIVER_11AC_SUPPORT is not set
# 禁用 802.11ax (Wi-Fi 6) 驱动支持
# CONFIG_DRIVER_11AX_SUPPORT is not set
# 禁用 mac80211 调试接口
# CONFIG_PACKAGE_MAC80211_DEBUGFS is not set
# 禁用 802.11s Mesh 组网支持
# CONFIG_PACKAGE_MAC80211_MESH is not set
# 禁用 Hostapd 基础组件
# CONFIG_PACKAGE_hostapd-common is not set
# 禁用 iw 无线配置工具
# CONFIG_PACKAGE_iw is not set
# 禁用 cfg80211 内核无线子系统
# CONFIG_PACKAGE_kmod-cfg80211 is not set
# 禁用 mac80211 内核模块
# CONFIG_PACKAGE_kmod-mac80211 is not set
# 禁用 MT76 驱动公用组件
# CONFIG_PACKAGE_kmod-mt76-connac is not set
# 禁用 MT76 驱动核心模块
# CONFIG_PACKAGE_kmod-mt76-core is not set
# 禁用 MT7915 PCIe 无线网卡驱动
# CONFIG_PACKAGE_kmod-mt7915e is not set
# 禁用 MT7916 固件
# CONFIG_PACKAGE_mt7916-firmware is not set
# 禁用 兆能 ZN515 MT7916 射频 EEPROM 校准文件
# CONFIG_PACKAGE_znxt-zn515-mt7916-eeprom is not set
# 禁用 无线信息获取库 libiwinfo
# CONFIG_PACKAGE_libiwinfo is not set
# 禁用 libiwinfo 芯片数据库
# CONFIG_PACKAGE_libiwinfo-data is not set
# 禁用 rpcd 的无线信息 RPC 插件
# CONFIG_PACKAGE_rpcd-mod-iwinfo is not set
# 禁用 ucode 的 nl80211 无线扩展
# CONFIG_PACKAGE_ucode-mod-nl80211 is not set
# 禁用 Wi-Fi 启停控制脚本
# CONFIG_PACKAGE_wifi-scripts is not set
# 禁用 无线国家射频合规数据库
# CONFIG_PACKAGE_wireless-regdb is not set
# 禁用 WPA/WPA2/WPA3 认证守护进程
# CONFIG_PACKAGE_wpad-openssl is not set
# 禁用 MBO 多频带快速漫游支持
# CONFIG_WPA_MBO_SUPPORT is not set

# ==============================================================================
# 6. 网络协议与路由/过滤内核驱动 (Networking & Netfilter)
# ==============================================================================
# Linux 网络桥接支持
CONFIG_PACKAGE_ip-bridge=y
# Linux MII/PHY 基础抽象层驱动
CONFIG_PACKAGE_kmod-libphy=y
# INET 套接字监视诊断内核支持
CONFIG_PACKAGE_kmod-inet-diag=y
# Netlink 协议诊断内核模块
CONFIG_PACKAGE_kmod-netlink-diag=y
# 流量控制/队列核心模块 (QoS 依赖)
CONFIG_PACKAGE_kmod-sched-core=y
# CAKE 智能队列流量管理调度算法 (防 Bufferbloat)
CONFIG_PACKAGE_kmod-sched-cake=y
# TCP BBR 拥塞控制算法
CONFIG_PACKAGE_kmod-tcp-bbr=y
# Netfilter 套接字状态追踪模块
CONFIG_PACKAGE_kmod-nf-socket=y
# Netfilter 透明代理核心模块
CONFIG_PACKAGE_kmod-nf-tproxy=y
# NFQUEUE 用户态数据包排队支持
CONFIG_PACKAGE_kmod-nfnetlink-queue=y
# nftables 桥接层过滤
CONFIG_PACKAGE_kmod-nft-bridge=y
# nftables 数据包排队转发模块
CONFIG_PACKAGE_kmod-nft-queue=y
# nftables 套接字匹配机制
CONFIG_PACKAGE_kmod-nft-socket=y
# nftables TProxy 透明转发模块
CONFIG_PACKAGE_kmod-nft-tproxy=y
# 内核级 DNS 解析服务 (NFS/CIFS 依赖)
CONFIG_PACKAGE_kmod-dnsresolver=y
# TUN/TAP 虚拟网卡驱动
CONFIG_PACKAGE_kmod-tun=y
# IPv4 UDP 隧道封装驱动
CONFIG_PACKAGE_kmod-udptunnel4=y
# IPv6 UDP 隧道封装驱动
CONFIG_PACKAGE_kmod-udptunnel6=y
# WireGuard VPN 驱动内核模块
CONFIG_PACKAGE_kmod-wireguard=y
# OpenVPN 数据通路 (ovpn-dco) 移植补丁模块
CONFIG_PACKAGE_kmod-ovpn-backports=y

# ==============================================================================
# 7. 内核硬件驱动与总线 (Bus, Storage, Hardware)
# ==============================================================================
# I2C 总线核心驱动 (读写光模块等)
CONFIG_PACKAGE_kmod-i2c-core=y
# 硬件监控子系统 (温度、电压、风扇等)
CONFIG_PACKAGE_kmod-hwmon-core=y
# 温控与热调节驱动模块
CONFIG_PACKAGE_kmod-thermal=y
# USB 2.0 基础驱动
CONFIG_PACKAGE_kmod-usb2=y
# USB EHCI 控制器驱动
CONFIG_PACKAGE_kmod-usb-ehci=y
# 特殊 USB 存储设备协议支持扩展
CONFIG_PACKAGE_kmod-usb-storage-extras=y
