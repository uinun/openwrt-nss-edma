CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=y

# ==============================================================================
# 8. 文件系统驱动与字符集 (Filesystem & Storage Drivers)
# ==============================================================================
# AutoFS4 自动挂载文件系统支持
CONFIG_PACKAGE_kmod-fs-autofs4=y
# 文件系统网络导出支持 (NFS Server 必备)
CONFIG_PACKAGE_kmod-fs-exportfs=y
# NFS 网络文件系统客户端
CONFIG_PACKAGE_kmod-fs-nfs=y
# NFS 协议公共支持库
CONFIG_PACKAGE_kmod-fs-nfs-common=y
# NFS RPCSEC_GSS 安全认证协议模块
CONFIG_PACKAGE_kmod-fs-nfs-common-rpcsec=y
# NFS 内核级服务端
CONFIG_PACKAGE_kmod-fs-nfsd=y
# Paragon NTFS3 内核级原生读写驱动
CONFIG_PACKAGE_kmod-fs-ntfs3=y
# 高性能 XFS 文件系统驱动
CONFIG_PACKAGE_kmod-fs-xfs=y
# 微软 GBK/CP936 简体中文字符集支持
CONFIG_PACKAGE_kmod-nls-cp936=y

# ==============================================================================
# 9. 内核加密库 (Kernel Cryptographic API)
# ==============================================================================
# AEAD (带认证加密) 框架接口
CONFIG_PACKAGE_kmod-crypto-aead=y
# 联合认证加密封装模块
CONFIG_PACKAGE_kmod-crypto-authenc=y
# CBC 密码分组链接模式
CONFIG_PACKAGE_kmod-crypto-cbc=y
# 禁用 CCM 模式
# CONFIG_PACKAGE_kmod-crypto-ccm
# ChaCha20-Poly1305 加密算法 (WireGuard/代理加速)
CONFIG_PACKAGE_kmod-crypto-chacha20poly1305=y
# 基于密文的消息认证码
CONFIG_PACKAGE_kmod-crypto-cmac=y
# 密文挪用模式 (Cipher Text Stealing)
CONFIG_PACKAGE_kmod-crypto-cts=y
# 禁用 旧版 IV 生成器模块
# CONFIG_PACKAGE_kmod-crypto-geniv
# HMAC 消息认证码
CONFIG_PACKAGE_kmod-crypto-hmac=y
# 密钥协商算法原生接口 (Key-agreement protocol)
CONFIG_PACKAGE_kmod-crypto-kpp=y
# ChaCha20 内核基础算法库
CONFIG_PACKAGE_kmod-crypto-lib-chacha20=y
# ChaCha20-Poly1305 内核算法库
CONFIG_PACKAGE_kmod-crypto-lib-chacha20poly1305=y
# Curve25519 椭圆曲线算法库
CONFIG_PACKAGE_kmod-crypto-lib-curve25519=y
# Poly1305 消息鉴别算法库
CONFIG_PACKAGE_kmod-crypto-lib-poly1305=y
# 密码算法自检与自动化匹配管理器
CONFIG_PACKAGE_kmod-crypto-manager=y
# 空加密算法 (用于调试与性能测试)
CONFIG_PACKAGE_kmod-crypto-null=y
# 禁用 伪随机数发生器内核模块
# CONFIG_PACKAGE_kmod-crypto-rng
# 禁用 序列化初始化向量发生器
# CONFIG_PACKAGE_kmod-crypto-seqiv
# SHA-256 哈希散列算法
CONFIG_PACKAGE_kmod-crypto-sha256=y
# 禁用 SHA-3 哈希算法
# CONFIG_PACKAGE_kmod-crypto-sha3
# SHA-512 哈希散列算法
CONFIG_PACKAGE_kmod-crypto-sha512=y
# ASN.1 对象标识符 (OID) 注册解析驱动
CONFIG_PACKAGE_kmod-oid-registry=y
# 禁用 多项式算法驱动
# CONFIG_PACKAGE_kmod-polynomial
# 禁用 用户态电压调节器驱动
# CONFIG_PACKAGE_kmod-regulator-userspace-consumer

# ==============================================================================
# 10. 文件共享与存储服务 (NAS / File Sharing Services)
# ==============================================================================
# Samba 4 文件共享服务器
CONFIG_PACKAGE_samba4-server=y
# Samba 4 核心依赖库
CONFIG_PACKAGE_samba4-libs=y
# 开启 Samba 的 Avahi 局域网服务广播发现
