CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_spectrum_sax1v1k=y

# CONFIG_PACKAGE_kmod-usb-core is not set
# CONFIG_PACKAGE_kmod-usb-dwc3 is not set
# CONFIG_PACKAGE_kmod-usb-dwc3-qcom is not set
# CONFIG_PACKAGE_kmod-usb3 is not set

## docker插件
CONFIG_PACKAGE_luci-app-dockerman=y

## aria2下载插件
CONFIG_PACKAGE_luci-app-aria2=y
CONFIG_PACKAGE_ariang=y

## 支持挂载远程 NFS
CONFIG_PACKAGE_kmod-fs-nfs-v4=y
CONFIG_PACKAGE_nfs-utils-v4=y

## 自动挂载插件
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blockd=y
CONFIG_PACKAGE_mount-utils=y

## 共享插件
CONFIG_PACKAGE_luci-app-ksmbd=y

## 分区管理工具
CONFIG_PACKAGE_cfdisk=y

## 格式化 ext4
CONFIG_PACKAGE_e2fsprogs=y

## USB挂载格式支持插件
CONFIG_PACKAGE_kmod-fs-ext4=y

## 查看分区插件
CONFIG_PACKAGE_lsblk=y


## 添加标准的全局中文包配置（只要主 App 存在，对应语言会自动打包生效）
CONFIG_LUCI_LANG_zh_Hans=y
